@page
@model DSA_Marathon.Web.Pages.Student.LeaderBoardModel
@{
    ViewData["Title"] = "Bảng xếp hạng";
}

<style>
    body {
        background: linear-gradient(135deg, #007bff, #6610f2);
        min-height: 100vh;
        font-family: 'Poppins', sans-serif;
        color: #333;
    }

    .leaderboard-container {
        background: #fff;
        border-radius: 25px;
        box-shadow: 0 8px 25px rgba(0,0,0,0.15);
        padding: 40px 60px;
        margin-top: 60px;
        margin-bottom: 40px;
        animation: fadeIn 0.8s ease-in-out;
    }

    h2 {
        font-weight: 700;
        color: #0056b3;
        text-align: center;
    }

    table {
        border-radius: 15px;
        overflow: hidden;
    }

    thead {
        background: #007bff;
        color: #fff;
        font-weight: 600;
        text-align: center;
    }

    tbody tr:nth-child(odd) {
        background-color: #f8f9fa;
    }

    tbody tr:hover {
        background-color: #e3f2fd;
        transition: 0.2s;
    }

    td, th {
        text-align: center;
        vertical-align: middle !important;
        font-size: 1rem;
        padding: 12px;
    }

    .rank-gold {
        color: #FFD700;
        font-weight: bold;
    }

    .rank-silver {
        color: #C0C0C0;
        font-weight: bold;
    }

    .rank-bronze {
        color: #CD7F32;
        font-weight: bold;
    }

    .btn-back {
        display: inline-block;
        margin-top: 25px;
        border-radius: 12px;
        padding: 12px 25px;
        font-size: 1.1rem;
        font-weight: 600;
        transition: all 0.2s ease-in-out;
    }

        .btn-back:hover {
            transform: scale(1.05);
        }

    .footer {
        text-align: center;
        color: #f8f9fa;
        margin-top: 50px;
        padding-bottom: 15px;
        font-size: 0.9rem;
    }
</style>

<div class="container leaderboard-container">
    <h2 class="mb-4">🏆 Bảng Xếp Hạng</h2>

    <table class="table table-bordered table-hover align-middle">
        <thead>
            <tr>
                <th>Hạng</th>
                <th>Tên đăng nhập</th>
                <th>Điểm</th>
                <th>Ngày làm bài</th>
                <th>Thời gian làm (phút)</th>
            </tr>
        </thead>
        <tbody>
            @{
                int rank = 1;
                foreach (var exam in Model.Exams)
                {
                    string rankClass = rank == 1 ? "rank-gold" : rank == 2 ? "rank-silver" : rank == 3 ? "rank-bronze" : "";
                    var duration = (exam.EndTime - exam.StartTime).TotalMinutes.ToString("F1");
                }
            }
            @for (int i = 0; i < Model.Exams.Count; i++)
            {
                var exam = Model.Exams[i];
                string rankClass = i == 0 ? "rank-gold" : i == 1 ? "rank-silver" : i == 2 ? "rank-bronze" : "";
                var duration = (exam.EndTime - exam.StartTime).TotalMinutes.ToString("F1");

                <tr>
                    <td class="@rankClass">@((i + 1))</td>
                    <td>@exam.Username</td>
                    <td><strong>@exam.Score</strong></td>
                    <td>@exam.EndTime.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@duration</td>
                </tr>
            }
        </tbody>
    </table>

    <div class="text-center">
        <a asp-page="/Index" class="btn btn-secondary btn-back">⬅ Quay lại trang chủ</a>
    </div>
</div>

<div class="footer">
    <hr class="border-light w-50 mx-auto">
    <p class="mb-1">© @DateTime.Now.Year <strong>AlarmBotKiJo</strong>. All rights reserved.</p>
    <p>Made with ❤️ to celebrate your effort and knowledge.</p>
</div>
