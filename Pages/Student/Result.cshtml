@page
@model DSA_Marathon.Web.Pages.Student.ResultModel
@{
    ViewData["Title"] = "Kết quả bài thi";
}

<style>
    body {
        background: linear-gradient(135deg, #00c6ff, #0072ff);
        font-family: 'Poppins', sans-serif;
        color: #333;
        min-height: 100vh;
    }

    .result-container {
        background: #fff;
        border-radius: 25px;
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
        padding: 40px 60px;
        margin-top: 60px;
        animation: fadeIn 0.8s ease-in-out;
    }

    h2 {
        font-weight: 700;
        color: #28a745;
        text-align: center;
    }

    h4, h5 {
        font-weight: 600;
    }

    .table {
        border-radius: 15px;
        overflow: hidden;
    }

        .table thead {
            background-color: #007bff;
            color: white;
        }

        .table tbody tr:hover {
            background-color: #e3f2fd;
            transition: 0.2s;
        }

    .btn {
        border-radius: 12px;
        font-weight: 600;
        font-size: 1.05rem;
        padding: 10px 20px;
        transition: all 0.2s ease-in-out;
    }

        .btn:hover {
            transform: scale(1.05);
        }

    .footer {
        text-align: center;
        color: #f8f9fa;
        margin-top: 60px;
        padding-bottom: 15px;
        font-size: 0.9rem;
    }

    }
</style>

<div class="container result-container">
    <h2 class="mb-4">🎯 Kết quả bài thi</h2>

    <div class="card shadow-sm p-4 mb-4 border-0">
        <h4 class="text-center mb-3">
            Điểm số: <span class="text-primary display-6 fw-bold">@Model.Score</span>
        </h4>

        <p class="text-center mb-4">
            <strong>Số câu đúng:</strong> @Model.CorrectAnswers / @Model.TotalQuestions
        </p>

        <h5 class="text-center text-secondary mb-3">📘 Phân loại theo Bloom</h5>

        <table class="table table-bordered table-hover">
            <thead>
                <tr>
                    <th>Mức Bloom</th>
                    <th>Số câu đúng</th>
                    <th>Tổng số câu</th>
                    <th>Tỷ lệ (%)</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var bloom in Model.BloomCorrect.Keys)
                {
                    var correct = Model.BloomCorrect[bloom];
                    var total = Model.BloomTotal[bloom];
                    var percent = total > 0 ? (correct * 100.0 / total) : 0;
                    <tr>
                        <td>@bloom</td>
                        <td>@correct</td>
                        <td>@total</td>
                        <td>@percent.ToString("F1")%</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="d-flex justify-content-center gap-3">
        <a asp-page="/Student/DoExam" class="btn btn-primary">📝 Làm lại bài</a>
        <a asp-page="/Student/LeaderBoard" class="btn btn-success">🏆 Xem bảng xếp hạng</a>
        <a asp-page="/Index" class="btn btn-secondary">🏠 Trang chủ</a>
    </div>
</div>

<div class="footer">
    <hr class="border-light w-50 mx-auto">
    <p class="mb-1">© @DateTime.Now.Year <strong>AlarmBotKiJo</strong>. All rights reserved.</p>
    <p>Made with ❤️ to celebrate your hard work and knowledge.</p>
</div>
